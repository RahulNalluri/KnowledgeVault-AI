# Django development settings
# These known values are for local development only. Production must inject
# independent secrets and must never reuse them.
DJANGO_SECRET_KEY=knowledgevault-development-only-key-not-for-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000
KV_CORS_ALLOWED_ORIGINS=http://localhost:3000
BACKEND_PORT=8000
KV_FRONTEND_URL=http://localhost:3000
KV_DEFAULT_FROM_EMAIL=no-reply@localhost
# Development defaults to console email output. Override this only when testing SMTP.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Production SMTP configuration (not used by the default development backend)
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=replace-me
# EMAIL_HOST_PASSWORD=replace-me

# PostgreSQL development settings
POSTGRES_DB=knowledgevault
POSTGRES_USER=knowledgevault
POSTGRES_PASSWORD=knowledgevault
POSTGRES_PORT=5432
DATABASE_URL=postgresql://knowledgevault:knowledgevault@localhost:5432/knowledgevault

# Redis development settings
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380/0

# Celery development settings
CELERY_BROKER_URL=redis://localhost:6380/1
CELERY_WORKER_CONCURRENCY=2
