# Django development settings
# These known values are for local development only. Production must inject
# independent secrets and must never reuse them.
DJANGO_SECRET_KEY=knowledgevault-development-only-key-not-for-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000

# PostgreSQL development settings
POSTGRES_DB=knowledgevault
POSTGRES_USER=knowledgevault
POSTGRES_PASSWORD=knowledgevault
POSTGRES_PORT=5432
DATABASE_URL=postgresql://knowledgevault:knowledgevault@localhost:5432/knowledgevault
